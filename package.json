{
  "name": "cursor-daw",
  "displayName": "Cursor DAW",
  "description": "纯文本多轨 DAW：鼓/钢琴/吉他/贝斯、MIDI+SoundFont 播放",
  "version": "1.0.0",
  "publisher": "cursor-daw",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onLanguage:cursor-daw",
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "cursor-daw",
        "aliases": [
          "Cursor DAW",
          "daw"
        ],
        "extensions": [
          ".daw"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "cursor-daw",
        "scopeName": "source.cursor-daw",
        "path": "./syntaxes/cursor-daw.tmLanguage.json"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "cursorDaw",
          "title": "Cursor DAW",
          "icon": "media/daw.svg"
        }
      ]
    },
    "views": {
      "cursorDaw": [
        {
          "id": "cursorDaw.playlist",
          "name": "播放列表"
        },
        {
          "id": "cursorDaw.recorder",
          "name": "键盘录制"
        },
        {
          "id": "cursorDaw.creator",
          "name": "创建"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "cursorDaw.playlist",
        "contents": "谱库为空。\n[创建工程](command:cursorDaw.newScore)"
      }
    ],
    "commands": [
      {
        "command": "cursorDaw.playPause",
        "title": "Cursor DAW: Play/Pause"
      },
      {
        "command": "cursorDaw.restart",
        "title": "Cursor DAW: Restart"
      },
      {
        "command": "cursorDaw.stop",
        "title": "Cursor DAW: Stop"
      },
      {
        "command": "cursorDaw.enablePadMode",
        "title": "Cursor DAW: 开启 Pad 模式",
        "category": "Cursor DAW"
      },
      {
        "command": "cursorDaw.togglePadMode",
        "title": "Cursor DAW: 切换 Pad 模式",
        "category": "Cursor DAW"
      },
      {
        "command": "cursorDaw.exitPadMode",
        "title": "Cursor DAW: 退出 Pad 模式",
        "category": "Cursor DAW"
      },
      {
        "command": "cursorDaw.insertRuler",
        "title": "Cursor DAW: Insert Ruler"
      },
      {
        "command": "cursorDaw.formatScore",
        "title": "Cursor DAW: Format Score"
      },
      {
        "command": "cursorDaw.newScore",
        "title": "Cursor DAW: New Score",
        "icon": "$(new-file)"
      },
      {
        "command": "cursorDaw.padHit",
        "title": "Cursor DAW: Pad Hit"
      },
      {
        "command": "cursorDaw.openManual",
        "title": "Cursor DAW: 打开说明书",
        "icon": "$(book)"
      },
      {
        "command": "cursorDaw.warmUpAudio",
        "title": "Cursor DAW: 启动音频引擎"
      },
      {
        "command": "cursorDaw.pickTrack",
        "title": "Cursor DAW: 切换乐器"
      },
      {
        "command": "cursorDaw.octaveUp",
        "title": "Cursor DAW: 升八度"
      },
      {
        "command": "cursorDaw.octaveDown",
        "title": "Cursor DAW: 降八度"
      },
      {
        "command": "cursorDaw.exportMidi",
        "title": "Cursor DAW: 导出 MIDI"
      },
      {
        "command": "cursorDaw.importMidi",
        "title": "Cursor DAW: 导入 MIDI"
      },
      {
        "command": "cursorDaw.syncLibrary",
        "title": "Cursor DAW: 同步示例工程",
        "icon": "$(cloud-download)"
      },
      {
        "command": "cursorDaw.refreshLibrary",
        "title": "Cursor DAW: 刷新播放列表",
        "icon": "$(refresh)"
      },
      {
        "command": "cursorDaw.openLibraryScore",
        "title": "Cursor DAW: 打开工程"
      },
      {
        "command": "cursorDaw.playLibraryScore",
        "title": "Cursor DAW: 播放工程",
        "icon": "$(play)"
      },
      {
        "command": "cursorDaw.pauseLibraryScore",
        "title": "Cursor DAW: 暂停工程",
        "icon": "$(debug-pause)"
      },
      {
        "command": "cursorDaw.deleteLibraryScore",
        "title": "Cursor DAW: 删除工程",
        "icon": "$(trash)"
      },
      {
        "command": "cursorDaw.createLibraryFolder",
        "title": "Cursor DAW: 新建目录",
        "icon": "$(new-folder)"
      },
      {
        "command": "cursorDaw.renameLibraryFolder",
        "title": "Cursor DAW: 重命名目录",
        "icon": "$(edit)"
      },
      {
        "command": "cursorDaw.deleteLibraryFolder",
        "title": "Cursor DAW: 删除目录",
        "icon": "$(trash)"
      },
      {
        "command": "cursorDaw.newScoreInFolder",
        "title": "Cursor DAW: 在此目录创建工程",
        "icon": "$(new-file)"
      },
      {
        "command": "cursorDaw.creatorSetFolder",
        "title": "Cursor DAW: 设置创建目录"
      },
      {
        "command": "cursorDaw.toggleRecording",
        "title": "Cursor DAW: 切换录制"
      },
      {
        "command": "cursorDaw.creatorSetName",
        "title": "Cursor DAW: 设置名称"
      },
      {
        "command": "cursorDaw.creatorSetBpm",
        "title": "Cursor DAW: 设置 BPM"
      },
      {
        "command": "cursorDaw.creatorSetBars",
        "title": "Cursor DAW: 设置小节数"
      },
      {
        "command": "cursorDaw.creatorCreate",
        "title": "Cursor DAW: 创建工程"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "cursorDaw.refreshLibrary",
          "when": "view == cursorDaw.playlist",
          "group": "navigation"
        },
        {
          "command": "cursorDaw.syncLibrary",
          "when": "view == cursorDaw.playlist",
          "group": "navigation"
        },
        {
          "command": "cursorDaw.newScore",
          "when": "view == cursorDaw.playlist",
          "group": "navigation"
        },
        {
          "command": "cursorDaw.createLibraryFolder",
          "when": "view == cursorDaw.playlist",
          "group": "navigation"
        },
        {
          "command": "cursorDaw.openManual",
          "when": "view == cursorDaw.playlist",
          "group": "navigation"
        },
        {
          "command": "cursorDaw.openManual",
          "when": "view == cursorDaw.recorder",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "cursorDaw.playLibraryScore",
          "when": "view == cursorDaw.playlist && viewItem == cursorDaw.score",
          "group": "inline"
        },
        {
          "command": "cursorDaw.playLibraryScore",
          "when": "view == cursorDaw.playlist && viewItem == cursorDaw.scorePaused",
          "group": "inline"
        },
        {
          "command": "cursorDaw.pauseLibraryScore",
          "when": "view == cursorDaw.playlist && viewItem == cursorDaw.scorePlaying",
          "group": "inline"
        },
        {
          "command": "cursorDaw.deleteLibraryScore",
          "when": "view == cursorDaw.playlist && viewItem == cursorDaw.score",
          "group": "2_destructive"
        },
        {
          "command": "cursorDaw.deleteLibraryScore",
          "when": "view == cursorDaw.playlist && viewItem == cursorDaw.scorePaused",
          "group": "2_destructive"
        },
        {
          "command": "cursorDaw.newScoreInFolder",
          "when": "view == cursorDaw.playlist && viewItem == cursorDaw.folder",
          "group": "1_create"
        },
        {
          "command": "cursorDaw.createLibraryFolder",
          "when": "view == cursorDaw.playlist && viewItem == cursorDaw.folder",
          "group": "1_create"
        },
        {
          "command": "cursorDaw.renameLibraryFolder",
          "when": "view == cursorDaw.playlist && viewItem == cursorDaw.folder",
          "group": "2_modify"
        },
        {
          "command": "cursorDaw.deleteLibraryFolder",
          "when": "view == cursorDaw.playlist && viewItem == cursorDaw.folder",
          "group": "2_destructive"
        }
      ]
    },
    "keybindings": [
      {
        "command": "cursorDaw.playPause",
        "key": "ctrl+enter",
        "mac": "cmd+enter",
        "when": "editorLangId == cursor-daw"
      },
      {
        "command": "cursorDaw.restart",
        "key": "ctrl+shift+enter",
        "mac": "cmd+shift+enter",
        "when": "editorLangId == cursor-daw"
      },
      {
        "command": "cursorDaw.togglePadMode",
        "key": "ctrl+d",
        "mac": "cmd+d",
        "when": "!inputFocus && !editorTextFocus"
      },
      {
        "command": "cursorDaw.togglePadMode",
        "key": "ctrl+'",
        "mac": "cmd+'",
        "when": "editorLangId == cursor-daw && !inputFocus"
      },
      {
        "command": "cursorDaw.exitPadMode",
        "key": "escape",
        "when": "cursorDaw.padMode && !inputFocus"
      },
      {
        "command": "cursorDaw.padHit",
        "key": "z",
        "when": "cursorDaw.padMode && !inputFocus || cursorDaw.padMode && editorTextFocus && editorLangId == cursor-daw",
        "args": "z"
      },
      {
        "command": "cursorDaw.padHit",
        "key": "x",
        "when": "cursorDaw.padMode && !inputFocus || cursorDaw.padMode && editorTextFocus && editorLangId == cursor-daw",
        "args": "x"
      },
      {
        "command": "cursorDaw.padHit",
        "key": "c",
        "when": "cursorDaw.padMode && !inputFocus || cursorDaw.padMode && editorTextFocus && editorLangId == cursor-daw",
        "args": "c"
      },
      {
        "command": "cursorDaw.padHit",
        "key": "v",
        "when": "cursorDaw.padMode && !inputFocus || cursorDaw.padMode && editorTextFocus && editorLangId == cursor-daw",
        "args": "v"
      },
      {
        "command": "cursorDaw.padHit",
        "key": "b",
        "when": "cursorDaw.padMode && !inputFocus || cursorDaw.padMode && editorTextFocus && editorLangId == cursor-daw",
        "args": "b"
      },
      {
        "command": "cursorDaw.padHit",
        "key": "n",
        "when": "cursorDaw.padMode && !inputFocus || cursorDaw.padMode && editorTextFocus && editorLangId == cursor-daw",
        "args": "n"
      },
      {
        "command": "cursorDaw.padHit",
        "key": "m",
        "when": "cursorDaw.padMode && !inputFocus || cursorDaw.padMode && editorTextFocus && editorLangId == cursor-daw",
        "args": "m"
      },
      {
        "command": "cursorDaw.padHit",
        "key": "a",
        "when": "cursorDaw.padMode && !inputFocus || cursorDaw.padMode && editorTextFocus && editorLangId == cursor-daw",
        "args": "a"
      },
      {
        "command": "cursorDaw.padHit",
        "key": "s",
        "when": "cursorDaw.padMode && !inputFocus || cursorDaw.padMode && editorTextFocus && editorLangId == cursor-daw",
        "args": "s"
      },
      {
        "command": "cursorDaw.padHit",
        "key": "d",
        "when": "cursorDaw.padMode && !inputFocus || cursorDaw.padMode && editorTextFocus && editorLangId == cursor-daw",
        "args": "d"
      },
      {
        "command": "cursorDaw.padHit",
        "key": "f",
        "when": "cursorDaw.padMode && !inputFocus || cursorDaw.padMode && editorTextFocus && editorLangId == cursor-daw",
        "args": "f"
      },
      {
        "command": "cursorDaw.padHit",
        "key": "g",
        "when": "cursorDaw.padMode && !inputFocus || cursorDaw.padMode && editorTextFocus && editorLangId == cursor-daw",
        "args": "g"
      },
      {
        "command": "cursorDaw.padHit",
        "key": "h",
        "when": "cursorDaw.padMode && !inputFocus || cursorDaw.padMode && editorTextFocus && editorLangId == cursor-daw",
        "args": "h"
      },
      {
        "command": "cursorDaw.padHit",
        "key": "j",
        "when": "cursorDaw.padMode && !inputFocus || cursorDaw.padMode && editorTextFocus && editorLangId == cursor-daw",
        "args": "j"
      },
      {
        "command": "cursorDaw.padHit",
        "key": "q",
        "when": "cursorDaw.padMode && !inputFocus || cursorDaw.padMode && editorTextFocus && editorLangId == cursor-daw",
        "args": "q"
      },
      {
        "command": "cursorDaw.padHit",
        "key": "w",
        "when": "cursorDaw.padMode && !inputFocus || cursorDaw.padMode && editorTextFocus && editorLangId == cursor-daw",
        "args": "w"
      },
      {
        "command": "cursorDaw.padHit",
        "key": "e",
        "when": "cursorDaw.padMode && !inputFocus || cursorDaw.padMode && editorTextFocus && editorLangId == cursor-daw",
        "args": "e"
      },
      {
        "command": "cursorDaw.padHit",
        "key": "r",
        "when": "cursorDaw.padMode && !inputFocus || cursorDaw.padMode && editorTextFocus && editorLangId == cursor-daw",
        "args": "r"
      },
      {
        "command": "cursorDaw.padHit",
        "key": "t",
        "when": "cursorDaw.padMode && !inputFocus || cursorDaw.padMode && editorTextFocus && editorLangId == cursor-daw",
        "args": "t"
      },
      {
        "command": "cursorDaw.padHit",
        "key": "y",
        "when": "cursorDaw.padMode && !inputFocus || cursorDaw.padMode && editorTextFocus && editorLangId == cursor-daw",
        "args": "y"
      },
      {
        "command": "cursorDaw.padHit",
        "key": "u",
        "when": "cursorDaw.padMode && !inputFocus || cursorDaw.padMode && editorTextFocus && editorLangId == cursor-daw",
        "args": "u"
      }
    ],
    "configuration": {
      "title": "Cursor DAW",
      "properties": {
        "cursorDaw.fileExtensions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "daw"
          ]
        },
        "cursorDaw.keyMap": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "default": {
            "a": "kick",
            "s": "snare",
            "d": "ch",
            "f": "oh",
            "g": "clap",
            "q": "tom1",
            "w": "tom2",
            "e": "tom3",
            "r": "crash",
            "t": "ride"
          }
        },
        "cursorDaw.loop": {
          "type": "boolean",
          "default": true
        },
        "cursorDaw.padModeOnOpen": {
          "type": "boolean",
          "default": false
        }
      }
    }
  },
  "scripts": {
    "compile": "node esbuild.mjs",
    "check": "tsc --noEmit",
    "watch": "node esbuild.mjs --watch",
    "test": "jest",
    "verify:audio": "esbuild scripts/verifyAudio.ts --bundle --platform=node --format=cjs --external:node-web-audio-api --external:spessasynth_core --external:stb-vorbis --outfile=dist/verifyAudio.cjs --log-level=warning && node dist/verifyAudio.cjs",
    "fetch:sf2": "node scripts/fetchSf2.mjs",
    "package": "node scripts/fetchSf2.mjs && node scripts/trimNative.mjs && vsce package"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^20.17.0",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.25.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "node-web-audio-api": "^2.2.0",
    "spessasynth_core": "^4.3.22"
  }
}
